{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apgiframework/apgi-framework/protocols/schemas/protocol.schema.json",
  "title": "APGI Experimental Protocol 1.1",
  "description": "Version 1.1 empirical/computational protocol specification. Null denotes explicitly unknown or inapplicable values, never zero or approval. Structural validation does not establish empirical or regulatory readiness.",
  "x-version": "1.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "registry_ep",
    "title",
    "paper",
    "version",
    "last_updated",
    "specification_date",
    "study_status",
    "description",
    "sub_predictions",
    "participants",
    "apparatus",
    "trial_structure",
    "blocks",
    "dependent_variables",
    "primary_hypothesis",
    "primary_analysis",
    "power_analysis",
    "pre_registration",
    "apgi_parameters",
    "ethics",
    "quality_and_decision_rules",
    "submission_blocking_issues",
    "specification_sections",
    "provenance",
    "readiness"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "version": {
      "const": "1.1.0"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^APGI-P0[0-7]$"
    },
    "registry_ep": {
      "type": "string",
      "pattern": "^EP-[0-7]$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "paper": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "specification_date": {
      "type": "string",
      "format": "date"
    },
    "study_status": {
      "enum": [
        "pre_collection",
        "collecting",
        "completed"
      ]
    },
    "participants": {
      "type": "object",
      "required": [
        "n_target",
        "n_minimum",
        "unit",
        "inclusion_criteria",
        "exclusion_criteria"
      ],
      "properties": {
        "n_target": {
          "type": "integer",
          "minimum": 1
        },
        "n_minimum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "n_analyzable_target": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "enum": [
            "human_participants",
            "simulation_seeds_per_condition",
            "clinical_participants"
          ]
        },
        "inclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "patient_n_target": {
          "type": "integer",
          "minimum": 1
        },
        "sites": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "sub_predictions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "claim",
          "confirming_evidence",
          "falsifying_evidence",
          "indeterminate_rule",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Pred [0-7]\\.[A-G]$"
          },
          "status": {
            "enum": [
              "confirmatory",
              "secondary",
              "exploratory",
              "estimation",
              "estimation_first",
              "confirmatory_exploratory"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confirming_evidence": {
            "type": "string",
            "minLength": 1
          },
          "falsifying_evidence": {
            "type": "string",
            "minLength": 1
          },
          "indeterminate_rule": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "confirming_thresholds": {
            "type": "object"
          },
          "falsifying_thresholds": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "apparatus": {
      "type": "object",
      "minProperties": 1
    },
    "trial_structure": {
      "type": "object",
      "required": [
        "target",
        "response"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "type",
            "duration_ms"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "duration_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "response": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocks": {
      "type": "object",
      "required": [
        "practice_trials",
        "experimental_blocks",
        "total_experimental_trials"
      ],
      "properties": {
        "practice_trials": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "experimental_blocks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_experimental_trials": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trials_per_block": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "session_quest_topup_trials": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "dependent_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "primary_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "primary_analysis": {
      "type": "string",
      "minLength": 1
    },
    "power_analysis": {
      "type": "object",
      "required": [
        "design_type"
      ],
      "properties": {
        "design_type": {
          "enum": [
            "frequentist",
            "sequential",
            "simulation",
            "bayesian",
            "fixed_n"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "power": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n_required": {
          "type": "integer",
          "minimum": 1
        },
        "n_target": {
          "type": "integer",
          "minimum": 1
        },
        "bf10_threshold": {
          "type": "number",
          "exclusiveMinimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "design_type": {
                "enum": [
                  "frequentist",
                  "sequential"
                ]
              }
            }
          },
          "then": {
            "required": [
              "alpha",
              "power",
              "n_required"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "design_type": {
                "enum": [
                  "simulation",
                  "bayesian",
                  "fixed_n"
                ]
              }
            }
          },
          "then": {
            "required": [
              "n_target"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "pre_registration": {
      "type": "object",
      "required": [
        "platform",
        "project_url",
        "base_registration_url",
        "base_registration_date",
        "amendment"
      ],
      "properties": {
        "platform": {
          "const": "OSF"
        },
        "project_url": {
          "type": "string",
          "format": "uri"
        },
        "base_registration_url": {
          "type": "string",
          "format": "uri"
        },
        "base_registration_date": {
          "type": "string",
          "format": "date"
        },
        "amendment": {
          "type": "object",
          "required": [
            "number",
            "document_stated_date",
            "identifier",
            "verification_status"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "document_stated_date": {
              "type": "string",
              "format": "date"
            },
            "identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "verification_status": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "apgi_parameters": {
      "type": "object",
      "required": [
        "model",
        "reduced_quantities",
        "kappa",
        "gain_interpretation",
        "parameter_manifest_status"
      ],
      "properties": {
        "reduced_quantities": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "theta_0",
              "eta",
              "tau_theta",
              "gamma_sig",
              "rho",
              "Pi_i",
              "Pi_e",
              "beta_SM"
            ]
          }
        },
        "kappa": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "status"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "ATP/bit"
            },
            "status": {
              "enum": [
                "uncalibrated",
                "calibrated"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "uncalibrated"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "gain_interpretation": {
          "type": "string",
          "minLength": 1
        },
        "parameter_manifest_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "ethics": {
      "type": "object",
      "required": [
        "committee",
        "approval_status",
        "protocol_number",
        "approval_date",
        "enrollment_authorized"
      ],
      "properties": {
        "committee": {
          "type": "string",
          "minLength": 1
        },
        "approval_status": {
          "enum": [
            "not_yet_submitted",
            "pending",
            "approved",
            "exempt"
          ]
        },
        "protocol_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "enrollment_authorized": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "protocol_number": {
                "type": "string",
                "minLength": 1
              },
              "approval_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_status": {
                "enum": [
                  "not_yet_submitted",
                  "pending"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "protocol_number": {
                "type": "null"
              },
              "approval_date": {
                "type": "null"
              },
              "enrollment_authorized": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "quality_and_decision_rules": {
      "type": "object",
      "required": [
        "data_admissibility",
        "scenarios",
        "protocol_alpha_specification"
      ],
      "properties": {
        "data_admissibility": {
          "type": "string",
          "minLength": 1
        },
        "protocol_alpha_specification": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "object",
          "required": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "submission_blocking_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "specification_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "text"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_start_paragraph_line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_files",
        "input_file",
        "input_sha256",
        "input_version",
        "precedence"
      ],
      "properties": {
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "type": "string",
          "minLength": 1
        },
        "precedence": {
          "type": "string",
          "minLength": 1
        },
        "input_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "empirical_validation_performed",
        "registration_verified"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "empirical_validation_performed": {
          "type": "boolean"
        },
        "registration_verified": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol_id": {
            "const": "APGI-P00"
          }
        }
      },
      "then": {
        "properties": {
          "registry_ep": {
            "const": "EP-0"
          },
          "sub_predictions": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "Pred 0.A"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "Pred 0.B"
                    }
