            "const": "APGI-P01"
          }
        }
      },
      "then": {
        "properties": {
          "registry_ep": {
            "const": "EP-1"
          },
          "sub_predictions": {
            "minItems": 6,
            "maxItems": 6,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "Pred 1.A"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
