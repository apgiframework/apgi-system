                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "Pred 2.B"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
